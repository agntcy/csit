<?xml version="1.0" encoding="utf-8"?>
<!-- Hermetic feed: the CSIT .NET fixture consumes the published Agntcy.SlimA2A package
     (and its transitive A2A / Agntcy.Slim.SlimRpc deps) from nuget.org only. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
