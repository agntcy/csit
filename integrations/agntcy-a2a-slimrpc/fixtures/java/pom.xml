<?xml version="1.0" encoding="UTF-8"?>
<!--
  CSIT fixture: A2A echo agent + probe over SLIMRPC (lf.a2a.v1) for cross-language interop.
  Mirrors fixtures/go (cmd/server, cmd/probe), fixtures/python, and fixtures/dotnet.
  Consumes the PUBLISHED io.agntcy.slim:slim-a2a-java from Maven Central (like the other
  fixtures consume their published packages). Produces one shaded runnable jar with two
  modes: server / probe (run with enable-preview; see the launcher).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.agntcy.csit</groupId>
  <artifactId>csit-slim-a2a-java</artifactId>
  <version>0.0.1</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Keep in sync with the matrix baseline / other fixtures. -->
    <slim.a2a.java.version>0.1.1</slim.a2a.java.version>
    <slim.bindings.version>1.4.1</slim.bindings.version>
    <a2a.java.sdk.version>1.1.0.Final</a2a.java.sdk.version>
    <jna.version>5.14.0</jna.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.agntcy.slim</groupId>
      <artifactId>slim-a2a-java</artifactId>
      <version>${slim.a2a.java.version}</version>
    </dependency>
    <dependency>
      <groupId>io.agntcy.slim</groupId>
      <artifactId>slim-bindings-java</artifactId>
      <version>${slim.bindings.version}</version>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-server-common</artifactId>
      <version>${a2a.java.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-spec</artifactId>
      <version>${a2a.java.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-spec-grpc</artifactId>
      <version>${a2a.java.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>${jna.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>csit-slim-a2a-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>--enable-preview</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- Single runnable fat jar: target/csit-slim-a2a-java.jar -->
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <!-- Don't emit dependency-reduced-pom.xml into the source tree. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.agntcy.csit.slim.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
