{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // Bundler resolution mirrors @agntcy/slim-a2a's own tsconfig: the slim-bindings
    // .d.ts files ship extensionless re-exports that strict NodeNext rejects.
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
